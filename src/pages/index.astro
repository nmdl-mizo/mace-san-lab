---
import { withBasePath } from '../lib/paths';
import MaterialWonderland from '../components/MaterialWonderland.astro';
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href={withBasePath('/favicon.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBasePath('/favicon-32x32.png')} />
    <link rel="icon" href={withBasePath('/favicon.ico')} sizes="any" />
    <link rel="apple-touch-icon" href={withBasePath('/apple-touch-icon.png')} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="robots" content="noindex,nofollow" />
    <meta
      name="description"
      content="Material Wonderland — 原子とAIと好奇心が交わる，NMDLの非公式デザイン実験サイト．"
    />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;700&display=swap"
    />

    <title>mace-san ✳ Material Wonderland</title>
  </head>
  <body>
    <MaterialWonderland />

  </body>
</html>
