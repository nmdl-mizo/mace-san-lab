---
import CollectionIndexLayout from '../layouts/CollectionIndexLayout.astro';
import OfficialDocument from '../components/OfficialDocument.astro';
---

<CollectionIndexLayout
  title="About NMDL"
  eyebrow="Nano Materials Design Laboratory"
  intro="Research and contact information from the official NMDL website."
  description="NMDL research and address from the official website."
>
  <div class="space-y-14">
    <section aria-labelledby="about-research">
      <h2 id="about-research" class="mb-6 font-display text-3xl">Research</h2>
      <OfficialDocument name="research" />
    </section>
    <section aria-labelledby="about-address">
      <h2 id="about-address" class="mb-6 font-display text-3xl">Address and Contact</h2>
      <OfficialDocument name="address" />
    </section>
  </div>
</CollectionIndexLayout>