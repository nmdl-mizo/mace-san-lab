  "params": {
    "contact_form_action": "#",
    "copyright": "mace-san playground, <br> built for design experiments before preview and production"
  },

  "navigation_button": {
    "enable": true,
    "label": "preview site",
    "link": "https://nmdl-mizo.github.io/nmdl-mizo-preview/"
  },

  "disqus": {
    "enable": false,
    "shortname": "themefisher-template",
    "settings": {}
  },

  "metadata": {
    "meta_author": "TMizoguchi",
    "meta_image": "/images/content-1.png",
    "meta_description": "Experimental playground for large design changes before preview and production"
  }
