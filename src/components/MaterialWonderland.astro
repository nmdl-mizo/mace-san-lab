---
import { siteNav } from '../data/site';
import provenance from '../imported/official/provenance.json';
import { withBasePath as url } from '../lib/paths';
const people = provenance.homepage_staff;
const rooms = [
  { n: '01', title: 'ATOMIC', subtitle: '小さな構造から，大きな可能性へ．', text: 'Structure · bonding · interfaces', image: '/images/official/research-ana.png', href: '/research/', class: 'atomic' },
  { n: '02', title: 'INTELLIGENCE', subtitle: '計算とAIで，材料の未来を探る．', text: 'Simulation · machine learning', image: '/images/official/research-ml.png', href: '/research/', class: 'intelligence' },
  { n: '03', title: 'SIGNALS', subtitle: '見えない世界の，声を聴く．', text: 'Spectroscopy · characterization', image: '/images/official/research-spec.png', href: '/publications/', class: 'signals' },
];
---
<div class="wonderland" id="top">
  <a class="skip" href="#explore">Skip to research</a>
  <header>
    <a class="wordmark" href={url('/')} aria-label="mace-san home">mace<span>✳</span>san<small>NMDL / EXPERIMENTAL PLAYGROUND</small></a>
    <nav aria-label="Main navigation"><a href="#explore">Explore</a><a href={url('/members/')}>People</a><a href={url('/news/')}>News ↗</a></nav>
    <a class="official" href="https://nmdl-mizo.github.io/">Official site ↗</a>
  </header>
  <main>
    <section class="hero" aria-labelledby="hero-title">
      <div class="hero-top"><span>THE UNIVERSITY OF TOKYO / NMDL</span><span class="experiment">A DESIGN EXPERIMENT — NOT THE OFFICIAL SITE</span></div>
      <h1 id="hero-title">MATTER<br/><span class="italic">gets</span> <span class="weird">WEIRD.</span></h1>
      <div class="sculpture" aria-hidden="true">
        <svg viewBox="0 0 600 600" class="atom"><defs><radialGradient id="pearl" cx="30%" cy="25%"><stop stop-color="#fffce9"/><stop offset=".35" stop-color="#f8a6ca"/><stop offset=".7" stop-color="#ef3f8e"/><stop offset="1" stop-color="#861647"/></radialGradient><radialGradient id="lime"><stop stop-color="#fffedb"/><stop offset=".5" stop-color="#d9f64c"/><stop offset="1" stop-color="#779d15"/></radialGradient></defs><g class="orbits" fill="none" stroke="#252421" stroke-width="2"><ellipse cx="300" cy="300" rx="260" ry="100" transform="rotate(-35 300 300)"/><ellipse cx="300" cy="300" rx="260" ry="100" transform="rotate(40 300 300)"/><ellipse cx="300" cy="300" rx="115" ry="250" transform="rotate(15 300 300)"/></g><circle cx="300" cy="300" r="113" fill="url(#pearl)"/><circle cx="100" cy="420" r="38" fill="url(#lime)"/><circle cx="490" cy="422" r="26" fill="url(#lime)"/><circle cx="314" cy="60" r="28" fill="url(#pearl)"/></svg>
        <span class="object-label">OBJECT 001 / IMAGINARY MATTER<br/>ARTWORK · NOT SIMULATION DATA</span>
      </div>
      <div class="sticker" aria-hidden="true">STAY<br/>CURIOUS.<span>↗</span></div>
      <div class="hero-bottom"><p>原子の先に，<br/><strong>まだない世界を．</strong><small>Materials science. Human curiosity.<br/>A little beautifully strange.</small></p><a href="#explore" class="circle-link" aria-label="Explore the research rooms">ENTER<br/>THE LAB<span>↓</span></a><span class="vertical">SCROLL TO CHANGE YOUR PERSPECTIVE</span></div>
    </section>
    <div class="ticker" aria-hidden="true"><div>ATOMS MEET ALGORITHMS ✳ STAY CURIOUS ✳ DESIGNED MATERIALS ✳ ATOMS MEET ALGORITHMS ✳ STAY CURIOUS ✳ DESIGNED MATERIALS ✳ </div></div>
    <section class="research" id="explore" aria-labelledby="research-title">
      <div class="section-label"><span>01 / THE EXPLORATION ROOMS</span><span>SMALL SCALE. OPEN POSSIBILITIES.</span></div>
      <div class="section-intro"><h2 id="research-title">Serious science.<br/><em>Unexpected angles.</em></h2><p>構造，計算，スペクトル．<br/>異なる視点が交わるところから，<br/>材料の新しい可能性を探します．</p></div>
      <div class="rooms">{rooms.map(room => <a class={`room ${room.class}`} href={url(room.href)}><div class="room-top"><span>ROOM / {room.n}</span><span>↗</span></div><div class="image-wrap"><img src={url(room.image)} alt={room.text} loading="lazy" width="500" height="340" /></div><h3>{room.title}</h3><p>{room.subtitle}</p><small>{room.text}</small></a>)}</div>
    </section>
    <section class="manifesto" aria-labelledby="manifesto-title"><span class="section-label">02 / A DIFFERENT KIND OF LAB</span><h2 id="manifesto-title">NOT SCIENCE<br/>FICTION.<br/><em>SCIENCE</em> <span class="outline">FRICTION.</span></h2><div class="manifesto-bottom"><span class="asterisk" aria-hidden="true">✳</span><p>人とAI．実験とシミュレーション．<br/>違うものを，ぶつけてみよう．<small>Nano Materials Design Laboratory<br/>Institute of Industrial Science, The University of Tokyo</small></p><a href={url('/about/')}>Meet NMDL ↗</a></div></section>
    <section class="people" aria-labelledby="people-title"><div class="section-label"><span>03 / THE CURIOUS MINDS</span><a href={url('/members/')}>ALL MEMBERS ↗</a></div><div class="section-intro"><h2 id="people-title">Human, <em>after all.</em></h2><p>未来をつくるのは，好奇心．<br/>Meet the people behind the materials.</p></div><div class="portraits">{people.map((p,i) => <a href={url('/members/')} class="portrait"><div class="photo"><img src={url(p.image)} alt={p.name} loading="lazy" width="400" height="450"/><span>0{i+1} ↗</span></div><h3>{p.name}</h3><p>{p.role}</p></a>)}</div></section>
    <section class="source-update" aria-labelledby="objective-title">
      <div class="section-label"><span>04 / FROM THE OFFICIAL LABORATORY</span><a href={`${provenance.source_repository}/tree/${provenance.source_commit}`}>SOURCE · {provenance.source_commit.slice(0,7)} ↗</a></div>
      <h2 id="objective-title">Designed <em>Materials.</em></h2>
      <div class="objectives">{provenance.homepage_objectives.ja.map(text => <p>{text}</p>)}</div>
      <a class="archive-link" href={url('/research/')}>AI・Physical AI・計算・原子レベル計測の研究内容へ ↗</a>
      <h3 class="awards-title">RESEARCH NEWS / 最近の研究成果</h3>
      <div class="objectives">
        <p lang="ja"><strong>外挿誤差を3分の1以下に．</strong> 表現学習と物性予測を分離する転移学習により，評価した外挿テストでCGCNNに対する予測誤差を68%削減しました．この研究成果が<em>PRX Intelligence</em>に掲載され，プレスリリースしました．</p>
        <p lang="en"><strong>Extrapolation error cut to less than one-third.</strong> Our decoupled transfer learning approach reduced prediction error by 68% compared with CGCNN in the evaluated extrapolation test. This work has been published in <em>PRX Intelligence</em>, with a press release.</p>
      </div>
      <a class="archive-link" href="https://journals.aps.org/prxintelligence/abstract/10.1103/pbrg-x848">Open Access ↗</a>
      <a class="archive-link" href="https://www.eurekalert.org/news-releases/1152730">Press Release ↗</a>
      <h3 class="awards-title">RECENT AWARDS / 本家掲載の受賞情報</h3>
      <div class="award-list">{provenance.latest_awards.map((text,i) => <a href={url('/publications/#awards')}><span>0{i+1}</span><p>{text}</p><span>↗</span></a>)}</div>
      <a class="archive-link" href={url('/news/')}>本家から取り込んだニュースの全記録へ ↗</a>
      <nav class="social-links" aria-label="研究室のSNS">
        <a href="https://www.linkedin.com/in/teruyasu-mizoguchi-035395284/">LinkedIn ↗<span>｜研究成果メイン</span></a>
        <a href="https://x.com/nmdl_mizo">研究室 X ↗<span>｜研究室の日常</span></a>
      </nav>
    </section>
    <section class="directory"><span class="section-label">KEEP WANDERING / 探索をつづけよう</span><div>{siteNav.map((link, i) => <a href={link.href}><small>0{i+1}</small>{link.label}<span>↗</span></a>)}</div></section>
  </main>
  <footer><div class="footer-top"><a href="#top" class="footer-logo">mace✳san</a><p>A playground for possible futures.<br/>Experimental design / 非公式デザイン試験サイト</p><a href="#top" class="back-top">BACK TO TOP ↑</a></div><div class="footer-bottom"><span>NMDL · THE UNIVERSITY OF TOKYO</span><a href="https://nmdl-mizo.github.io/">Visit the official laboratory website ↗</a><button type="button" id="motion-toggle" aria-pressed="false">Pause motion Ⅱ</button></div></footer>
</div>
<script>
  const button = document.querySelector<HTMLButtonElement>('#motion-toggle');
  const surface = document.querySelector('.wonderland');
  button?.addEventListener('click', () => {
    const paused = surface?.classList.toggle('paused') ?? false;
    button.setAttribute('aria-pressed', String(paused));
    button.textContent = paused ? 'Resume motion ▷' : 'Pause motion Ⅱ';
  });
</script>
<style>
  .social-links{display:flex;flex-direction:column;align-items:flex-start;gap:0;margin-top:22px;font-size:13px}.social-links a{padding:12px 0;min-height:44px;text-decoration:underline;text-underline-offset:4px}.social-links span{text-decoration:none}
  .source-update{padding:65px 4% 80px;background:#efbdd0}.source-update h2{margin-top:40px}.objectives{display:grid;grid-template-columns:1fr 1fr;gap:40px;margin:25px 0}.objectives p{font-size:14px;line-height:2;margin:0}.archive-link{display:inline-block;border-bottom:1px solid;padding:15px 0;font-size:13px}.awards-title{margin:55px 0 20px;letter-spacing:1px;font-size:13px}.award-list a{display:flex;gap:25px;align-items:start;padding:22px 0;border-top:1px solid #25242166}.award-list span{font-size:12px}.award-list p{margin:0;white-space:pre-line;line-height:1.8;font-size:14px;flex:1;overflow-wrap:anywhere}.portrait h3{overflow-wrap:anywhere;line-height:1.5}@media(max-width:800px){.source-update{padding:45px 5%}.objectives{grid-template-columns:1fr;gap:16px}.source-update .section-label{flex-wrap:wrap}.award-list a{gap:12px}}
  :global(html){scroll-behavior:smooth;scroll-padding-top:30px;background:#f4f1e8} :global(body){margin:0} :global(*){box-sizing:border-box}
  .wonderland{--paper:#f4f1e8;--ink:#252421;--pink:#f65aa0;--lime:#ddf56a;background:var(--paper);color:var(--ink);font-family:'Space Grotesk','Arial',sans-serif;overflow:hidden}a{color:inherit;text-decoration:none}button{font:inherit}a:focus-visible,button:focus-visible{outline:3px solid #9b1655;outline-offset:5px} .skip{position:absolute;top:-100px;z-index:10;background:var(--lime);padding:15px}.skip:focus{top:5px}
  header{display:flex;align-items:center;justify-content:space-between;padding:27px 4%;border-bottom:1px solid var(--ink);gap:24px}.wordmark{font-size:34px;font-weight:700;letter-spacing:-2px;line-height:.9}.wordmark span{color:#ac1759;display:inline-block;margin:0 4px}.wordmark small{display:block;font-size:9px;letter-spacing:1.4px;margin-top:13px}nav{display:flex;gap:32px;font-size:14px}nav a,.official{padding:13px 0}.official{font-size:12px;border-bottom:1px solid}.hero{position:relative;padding:25px 4% 35px;min-height:850px}.hero-top,.section-label{display:flex;justify-content:space-between;gap:20px;font-size:10px;font-weight:700;letter-spacing:1.3px}.experiment{max-width:240px;text-align:right}h1{font-size:clamp(100px,14.8vw,225px);font-weight:700;line-height:.82;letter-spacing:-.085em;position:relative;z-index:2;pointer-events:none;margin:65px 0 0}.italic{font-family:Georgia,serif;font-style:italic;font-weight:400;letter-spacing:-.075em}.weird{color:#b51559}.sculpture{width:48%;position:absolute;right:1%;top:60px;z-index:1;transform:rotate(-8deg)}.atom{width:100%;overflow:visible;animation:float 10s ease-in-out infinite}.object-label{display:block;text-align:center;font-size:8px;letter-spacing:1.6px;line-height:1.6;transform:rotate(8deg)}.sticker{position:absolute;right:5%;top:52%;z-index:3;background:var(--lime);height:137px;width:137px;display:flex;flex-direction:column;justify-content:center;text-align:center;border-radius:50%;transform:rotate(14deg);font-size:19px;font-weight:700;line-height:1.05;border:1px solid}.sticker span{font-size:32px}.hero-bottom{position:relative;z-index:3;display:flex;align-items:end;justify-content:space-between;margin-top:55px;width:66%;gap:30px}.hero-bottom p{font-size:25px;line-height:1.55;margin:0}.hero-bottom small{display:block;font-size:12px;line-height:1.5;margin-top:20px}.circle-link{background:var(--ink);color:var(--paper);width:134px;height:134px;border-radius:50%;display:flex;flex-direction:column;justify-content:center;align-items:center;flex-shrink:0;font-size:12px;line-height:1.2;transform:rotate(-12deg);transition:transform .3s}.circle-link:hover{transform:rotate(0) scale(1.05)}.circle-link span{font-size:32px}.vertical{writing-mode:vertical-rl;font-size:8px;letter-spacing:2px}.ticker{background:var(--pink);border-block:1px solid;transform:rotate(-2deg) scale(1.03);padding:17px 0;font-size:25px;font-weight:700;white-space:nowrap}.ticker div{width:max-content;animation:marquee 32s linear infinite}.research,.people{padding:95px 4%}.section-intro{display:flex;justify-content:space-between;align-items:end;gap:35px;margin:45px 0}h2{font-size:clamp(36px,5.3vw,80px);line-height:1;letter-spacing:-.06em;margin:0;font-weight:500}h2 em{font-family:Georgia,serif;font-weight:400}.section-intro p{font-size:13px;line-height:1.9;max-width:330px;margin:0}.rooms{display:grid;grid-template-columns:1.1fr 1fr 1fr;gap:22px;align-items:start}.room{padding:22px;border:1px solid;transition:transform .3s;min-width:0}.room:hover{transform:translateY(-9px) rotate(-1deg)}.atomic{background:#e5e6db}.intelligence{background:var(--lime);margin-top:65px;transform:rotate(2deg)}.signals{background:#efbdd0;margin-top:20px}.room-top{display:flex;justify-content:space-between;font-size:10px;letter-spacing:1px}.room-top span:last-child{font-size:26px}.image-wrap{height:230px;display:flex;align-items:center;margin:22px 0;mix-blend-mode:multiply}.image-wrap img{width:100%;height:100%;object-fit:contain}.room h3{font-size:clamp(20px,2.4vw,36px);letter-spacing:-1.5px;margin:10px 0}.room p{font-size:12px;line-height:1.7}.room small{font-size:10px}.manifesto{background:var(--ink);color:var(--paper);padding:45px 4% 65px}.manifesto h2{font-size:clamp(55px,10.5vw,158px);font-weight:700;line-height:.95;margin:70px 0 45px;letter-spacing:-.07em}.manifesto em{color:var(--lime)}.outline{color:var(--pink)}.manifesto-bottom{display:flex;justify-content:space-between;align-items:center;gap:35px}.asterisk{font-size:130px;color:var(--pink);line-height:1}.manifesto-bottom p{line-height:1.8;font-size:18px}.manifesto-bottom small{display:block;font-size:10px;line-height:1.5;margin-top:20px}.manifesto-bottom a{border-bottom:1px solid;padding:18px 0;font-size:13px}.portraits{display:grid;grid-template-columns:repeat(4,1fr);gap:25px}.photo{aspect-ratio:4/4.5;background:#dfdcd2;position:relative;overflow:hidden}.photo img{width:100%;height:100%;object-fit:cover;filter:grayscale(1);transition:filter .4s,transform .4s}.portrait:hover img{filter:grayscale(0);transform:scale(1.03)}.portrait:nth-child(2){margin-top:45px}.portrait:nth-child(4){margin-top:45px}.photo span{position:absolute;bottom:12px;right:12px;background:var(--lime);padding:10px;font-size:12px}.portrait h3{font-size:17px;font-weight:500;margin:17px 0 5px}.portrait p{font-size:11px;margin:0}.directory{background:var(--lime);padding:45px 4% 65px}.directory>div{display:grid;grid-template-columns:1fr 1fr;column-gap:60px;margin-top:35px}.directory a{display:flex;align-items:center;gap:22px;font-size:clamp(23px,3vw,44px);padding:18px 0;border-bottom:1px solid #25242166;letter-spacing:-1px}.directory small{font-size:10px;letter-spacing:0}.directory a span{margin-left:auto}.directory a:hover{color:#9b1655}footer{padding:45px 4% 20px}.footer-top{display:flex;align-items:center;justify-content:space-between;gap:30px}.footer-logo{font-size:clamp(30px,6.3vw,96px);letter-spacing:-.07em;font-weight:700}.footer-top p{font-size:11px;line-height:1.7}.back-top{font-size:10px;padding:17px 0}.footer-bottom{border-top:1px solid;margin-top:40px;padding-top:18px;display:flex;justify-content:space-between;align-items:center;gap:20px;font-size:9px;letter-spacing:.5px}.footer-bottom button{border:1px solid;background:none;min-height:44px;padding:8px 14px;cursor:pointer}.paused *{animation-play-state:paused!important}@keyframes float{50%{transform:translateY(-17px) rotate(8deg)}}@keyframes marquee{to{transform:translateX(-50%)}}
  @media(min-width:1600px){.hero{min-height:1000px}}@media(max-width:800px){header{padding:20px 5%;flex-wrap:wrap;gap:20px}.wordmark{font-size:28px}nav{gap:20px}.official{display:none}.hero{min-height:0;padding:25px 5% 35px}.hero-top{font-size:8px}.experiment{max-width:145px}h1{font-size:17vw;margin-top:45px}.sculpture{position:relative;width:80%;margin:-15px 0 -50px 20%;right:auto;top:auto}.hero-bottom{width:100%;margin-top:15px;gap:10px}.hero-bottom p{font-size:21px}.hero-bottom small{font-size:10px}.circle-link{width:110px;height:110px}.vertical{display:none}.sticker{width:95px;height:95px;font-size:14px;top:45%;right:auto;left:6%}.sticker span{font-size:23px}.ticker{font-size:18px;padding:13px 0}.research,.people{padding:60px 5%}.section-label{font-size:8px}.section-intro{display:block;margin:30px 0}.section-intro p{margin-top:23px}.rooms{grid-template-columns:1fr;gap:25px}.room{padding:22px}.intelligence,.signals{margin-top:0;transform:none}.image-wrap{height:220px}.room h3{font-size:32px}.manifesto{padding:35px 5%}.manifesto h2{font-size:11vw;margin:45px 0}.manifesto-bottom{flex-wrap:wrap;gap:15px}.asterisk{font-size:80px}.manifesto-bottom p{font-size:13px}.portraits{grid-template-columns:1fr 1fr;gap:25px 15px}.portrait:nth-child(2),.portrait:nth-child(4){margin-top:25px}.portrait h3{font-size:14px}.directory{padding:35px 5%}.directory>div{column-gap:25px}.directory a{gap:10px;font-size:22px}.footer-top{flex-wrap:wrap}.footer-logo{font-size:55px}.footer-bottom{flex-wrap:wrap;font-size:8px}.footer-bottom a{padding:12px 0}}@media(prefers-reduced-motion:reduce){.wonderland *{animation:none!important;transition:none!important}:global(html){scroll-behavior:auto}}
</style>
